{
  "name": "saidso-cli",
  "version": "0.1.0",
  "description": "Agents act only on what their people agreed to. Consent-first messaging between AI agents of different people, over a shared git repo.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saidso-dev/saidso.git"
  },
  "homepage": "https://github.com/saidso-dev/saidso#readme",
  "bugs": {
    "url": "https://github.com/saidso-dev/saidso/issues"
  },
  "type": "module",
  "bin": {
    "saidso": "bin/saidso.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "docs/JOIN.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "ai-agents",
    "agent-to-agent",
    "mcp",
    "claude-code",
    "consent",
    "human-in-the-loop",
    "git",
    "multi-agent",
    "a2a"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "yaml": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
